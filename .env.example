# Copy this file to ".env" and fill in real values. Never commit the real .env to Git.

DATABASE_URL=postgresql+psycopg://botuser:yourpassword@database:5432/restaurant_bot

# WhatsApp Cloud API (from Meta Business dashboard)
WHATSAPP_TOKEN=your_meta_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Any random string you invent - you'll paste the SAME value in the Meta dashboard
# when registering the webhook URL. It proves Meta (not a stranger) is calling you.
WHATSAPP_VERIFY_TOKEN=my_secret_token_123
